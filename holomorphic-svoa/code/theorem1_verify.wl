(* ::Section:: *)
(* 2. Functions *)

(* ::Subsection:: *)
(* Basic checks *)

(* Words over F_3 are integer vectors with entries 0, 1, 2 (2 stands for -1).
   sigma(x) = prod_i s(x_i) with s(0) = 0, s(1) = 1, s(2) = -1, so sigma(x) = 0 unless x has full support.
   Index(C) = sum over codewords x of sigma(x); |Index| = 24 is what the theorem needs from each code. *)
(* sigma of every row of an integer matrix with entries 0,1,2: 0 if the row has a zero, else (-1)^(number of 2s) *)
sgnMat[m_] := (1 - Unitize[Total[1 - Unitize[m], {2}]]) (1 - 2 Mod[Total[Quotient[m, 2], {2}], 2]);
genMatrix[c_Association] := Map[ToExpression, Characters /@ c["generator"], {2}];
rref3[g_] := Select[RowReduce[g, Modulus -> 3], Max[Abs[#]] > 0 &];
rowspaceSHA256[g_] := Hash[StringToByteArray[StringRiffle[StringJoin /@ Map[ToString, rref3[g], {2}], "\n"]], "SHA256", "HexString"];
selfDualQ[g_] := Module[{d, n}, {d, n} = Dimensions[g];
   n == 2 d && MatrixRank[g, Modulus -> 3] == d && Max[Abs[Mod[g . Transpose[g], 3]]] == 0];

(* ::Subsection:: *)
(* Transfer matrices and the index *)

(* The transfer matrices.  Write R = (I | A).  A full-support codeword is x = (a | a A) with a in {1,2}^(n/2).
   Split the message coordinates into blocks R_0..R_{L-1} and the parity coordinates into blocks C_0..C_{L-1} of the
   same sizes (the band widths).  If A[R_i, C_j] = 0 unless j = i or i+1 (mod L) -- checked below -- then
      Index = Tr(T_0 T_1 ... T_{L-1}),
      T_i[u, v] = sum over a in {1,2}^(R_i) with a A[R_i, C_{i+1}] = v  of  sigma(a) sigma(u + a A[R_i, C_i]),
   where u runs over the vectors handed from block i-1 (the values of a' A[R_{i-1}, C_i]).  These are the
   3^r x 3^r cell matrices of the paper (r = number of boundary spins); U_i (the same with |sigma|) counts the
   full-support words, i.e. the Ramond ground states. *)
offsets[w_] := Prepend[Accumulate[w], 0];
blk[a_, off_, i_, j_] := a[[off[[i + 1]] + 1 ;; off[[i + 2]], off[[j + 1]] + 1 ;; off[[j + 2]]]];   (* blocks 0..L-1 *)
bandedQ[g_, w_] := Module[{d = Length[g], a, off = offsets[w], L = Length[w]},
   If[L < 3 || Last[off] =!= d || Dimensions[g] =!= {d, 2 d} || g[[All, ;; d]] =!= IdentityMatrix[d], Return[False]];
   a = g[[All, d + 1 ;;]];
   AllTrue[Tuples[Range[0, L - 1], 2],
    MemberQ[{#[[1]], Mod[#[[1]] + 1, L]}, #[[2]]] || Max[Abs[blk[a, off, #[[1]], #[[2]]]]] == 0 &]];
transferMatrices[g_, w_] := Module[{d = Length[g], a, off = offsets[w], L = Length[w], ins, outV, states, idx, mats},
   If[! bandedQ[g, w], Return[$Failed]];
   a = g[[All, d + 1 ;;]];
   ins = Table[Tuples[{1, 2}, w[[i + 1]]], {i, 0, L - 1}];
   outV = Table[Mod[ins[[i + 1]] . blk[a, off, i, Mod[i + 1, L]], 3], {i, 0, L - 1}];
   states = Union /@ outV;                    (* states[[i+1]]: vectors handed from block i to block i+1 *)
   idx = Table[Lookup[AssociationThread[states[[i]] -> Range[Length[states[[i]]]]], outV[[i]]], {i, L}];
   mats = Table[
     Module[{inc = states[[Mod[i - 1, L] + 1]], base = Mod[ins[[i + 1]] . blk[a, off, i, i], 3],
       phi = sgnMat[ins[[i + 1]]], wi = w[[i + 1]], nW, p, cols, nzT, twT, rows},
      nW = Length[phi];
      p = SparseArray[Transpose[{Range[nW], idx[[i + 1]]}] -> 1, {nW, Length[states[[i + 1]]]}];
      (* for each parity coordinate j and each value v of u_j: is (base_j + v) nonzero, is it 2 *)
      cols = Transpose[base];
      nzT = Table[Unitize[Mod[cols[[j]] + v, 3]], {j, wi}, {v, 0, 2}];
      twT = Table[Quotient[Mod[cols[[j]] + v, 3], 2], {j, wi}, {v, 0, 2}];
      rows = Table[Module[{nz, sg},
         nz = Times @@ Table[nzT[[j, u[[j]] + 1]], {j, wi}];
         sg = nz (1 - 2 Mod[Total[Table[twT[[j, u[[j]] + 1]], {j, wi}]], 2]);
         {Normal[(sg phi) . p], Normal[nz . p]}], {u, inc}];
      {rows[[All, 1]], rows[[All, 2]]}], {i, 0, L - 1}];
   <|"T" -> mats[[All, 1]], "U" -> mats[[All, 2]], "states" -> states|>];
indexFromTransfer[tm_] := {Tr[Dot @@ tm["T"]], Tr[Dot @@ tm["U"]]};
(* fallback for small codes: enumerate an information set (pivot values in {1,2}) *)
bruteIndex[g_] := Module[{r = rref3[g], d, sg}, d = Length[r];
   Which[d == 0, {0, 0}, d > 22, $Failed,
    True, sg = sgnMat[Mod[Tuples[{1, 2}, d] . r, 3]]; {Total[sg], Total[Abs[sg]]}]];
codeIndex[g_, w_] := Module[{res},
   If[bandedQ[g, w], Append[indexFromTransfer[transferMatrices[g, w]], "transfer matrices"],
    res = bruteIndex[g]; If[res === $Failed, $Failed, Append[res, "brute force over an information set"]]]];

(* ::Subsection:: *)
(* Symmetries and the orbifold hypotheses *)

(* Symmetries are signed permutations (perm, signs), perm 0-based as in the certificates: x -> y with
   y[perm[i]] = signs[i] x[i], i.e. y = x . M with M[i, perm[i]] = signs[i]. *)
spMatrix[perm_, signs_] := Module[{n = Length[perm]},
   Normal[SparseArray[Table[{i, perm[[i]] + 1} -> signs[[i]], {i, n}], {n, n}]]];
preservesQ[g_, m_] := Max[Abs[Mod[g . m . Transpose[g], 3]]] == 0;   (* C self-dual: x in C iff x . G^T = 0 *)
spOrder[m_] := Module[{x = m, o = 1, id = IdentityMatrix[Length[m]]}, While[x =!= id && o < 1000, x = x . m; o++]; o];
permAndSigns[m_] := Module[{p = Table[First[FirstPosition[m[[i]], v_ /; v != 0]], {i, Length[m]}]},
   {p, Table[m[[i, p[[i]]]], {i, Length[m]}]}];                     (* 1-based permutation and signs of a monomial matrix *)
cyclesOf[p_] := Module[{cyc = First[PermutationCycles[p]]},
   cyc = Join[cyc, List /@ Complement[Range[Length[p]], Flatten[cyc]]];
   RotateLeft[#, First[Ordering[#, 1]] - 1] & /@ cyc];               (* every cycle starts at its smallest element *)
cycleType[p_] := StringRiffle[KeyValueMap[ToString[#1] <> "^" <> ToString[#2] &, KeySort[Counts[Length /@ cyclesOf[p]]]], " "];

(* Signed count of the full-support codewords fixed by h (the balance condition of GJF Thm 5.6).  A fixed word is
   determined by its values at one coordinate per cycle: along a cycle c_1 -> c_2 -> ..., x[c_{t+1}] = s[c_t] x[c_t].
   For odd cycles its sign is eps * sigma(contracted word), eps = product of the partial sign products. *)
fixedBalance[g_, mh_, periodW_] := Module[{n = Length[mh], kk, nl, f, p, s, cycs, eps = 1, dead = False, reps, fc, res},
   kk = Mod[g . (mh - IdentityMatrix[n]), 3];
   nl = NullSpace[Transpose[kk], Modulus -> 3];                     (* a with a . G . (M_h - 1) = 0 *)
   If[nl === {}, Return[<|"fixedDim" -> 0, "signed" -> 0, "count" -> 0|>]];
   f = rref3[Mod[nl . g, 3]];
   {p, s} = permAndSigns[mh];
   cycs = cyclesOf[p];
   If[AnyTrue[cycs, EvenQ[Length[#]] &], Return[<|"fixedDim" -> Length[f], "note" -> "even cycle: not implemented"|>]];
   Do[Module[{cum = 1}, Do[eps *= cum; cum *= s[[t]], {t, c}]; If[cum != 1, dead = True]], {c, cycs}];
   If[dead, Return[<|"fixedDim" -> Length[f], "signed" -> 0, "count" -> 0, "note" -> "a cycle has sign product -1"|>]];
   reps = Sort[First /@ cycs];
   fc = rref3[f[[All, reps]]];
   res = Which[Length[fc] <= 20, bruteIndex[fc],
     bandedQ[fc, periodW], indexFromTransfer[transferMatrices[fc, periodW]], True, $Failed];
   If[res === $Failed, Return[<|"fixedDim" -> Length[f], "note" -> "balance not computed"|>]];
   <|"fixedDim" -> Length[f], "contractedLength" -> Length[reps], "contractedDim" -> Length[fc],
    "signed" -> eps res[[1]], "count" -> res[[2]], "even" -> (res[[2]] + eps res[[1]])/2,
    "odd" -> (res[[2]] - eps res[[1]])/2|>];

(* GJF Thm 5.6 for Z_m as used in the paper: g preserves C, has order m, g^(m/2) = -1 if m is even, and if 3 | m then
   h = g^(m/3) has n/3 three-cycles and the full-support words fixed by h are balanced (signed count 0). *)
checkCyclic[g_, gen_, m_, periodW_] := Module[{n = Length[First[g]], mg, out = <||>, ok, mh},
   mg = spMatrix[gen["perm"], gen["signs"]];
   out["g preserves C"] = preservesQ[g, mg];
   out["order of g"] = spOrder[mg];
   out["cycle type of g"] = cycleType[gen["perm"] + 1];
   ok = out["g preserves C"] && out["order of g"] == m;
   If[EvenQ[m], out["g^(m/2) = -1"] = Max[Abs[MatrixPower[mg, m/2] + IdentityMatrix[n]]] == 0;
    ok = ok && out["g^(m/2) = -1"]];
   If[Mod[m, 3] == 0,
    mh = MatrixPower[mg, m/3];
    out["cycle type of h = g^(m/3)"] = cycleType[First[permAndSigns[mh]]];
    out["h-fixed full-support words"] = fixedBalance[g, mh, periodW];
    ok = ok && out["cycle type of h = g^(m/3)"] === "3^" <> ToString[n/3] &&
      Lookup[out["h-fixed full-support words"], "signed", Missing[]] === 0];
   out["ok"] = TrueQ[ok]; out];

(* Q8: the quaternion relations and |group| = 8 (every element != 1 then has -1 as a power and commuting pairs
   generate cyclic subgroups).  That the action is non-anomalous is the Q8 lemma of the paper, not a finite check. *)
checkQ8[g_, gens_] := Module[{n = Length[First[g]], mi, mj, mk, minus, grp, out = <||>},
   mi = spMatrix[gens["i"]["perm"], gens["i"]["signs"]]; mj = spMatrix[gens["j"]["perm"], gens["j"]["signs"]];
   mk = mi . mj; minus = -IdentityMatrix[n];
   out["i, j preserve C"] = preservesQ[g, mi] && preservesQ[g, mj];
   out["i^2 = j^2 = k^2 = -1"] = AllTrue[{mi . mi, mj . mj, mk . mk}, Max[Abs[# - minus]] == 0 &];
   out["j i = -k"] = Max[Abs[mj . mi + mk]] == 0;
   grp = FixedPoint[Union[#, Flatten[Outer[Dot, #, {mi, mj}, 1], 1]] &, {IdentityMatrix[n]}];
   out["group order"] = Length[grp];
   out["cycle type of i"] = cycleType[gens["i"]["perm"] + 1];
   out["ok"] = TrueQ[out["i, j preserve C"] && out["i^2 = j^2 = k^2 = -1"] && out["j i = -k"] && out["group order"] == 8];
   out];

(* ::Subsection:: *)
(* Verification of one certificate *)

verifyCode[c_Association] := Module[{g = genMatrix[c], d, n, k = c["k"], m, r = <||>, ci, s, order, bw = c["bandWidths"]},
   {d, n} = Dimensions[g];
   r["id"] = c["id"]; r["k"] = k; r["c"] = 12 k; r["length"] = n;
   r["length = 12k"] = n == 12 k;
   r["rowspace hash = certificate"] = rowspaceSHA256[g] === c["sha256"];
   r["self-dual"] = selfDualQ[g];
   ci = codeIndex[g, bw];
   If[ci === $Failed, r["index"] = Missing["not computed"]; r["all finite checks pass"] = False; Return[r]];
   {r["index"], r["full-support words"], r["index method"]} = ci;
   r["|index| = 24"] = Abs[r["index"]] == 24; r["index = claimed"] = r["index"] == c["claimedIndex"];
   m = GCD[24, k];
   Which[
    c["group"] === "Q8", s = checkQ8[g, c["generators"]]; order = 8;
     r["orbifold rests on"] = "Q8 lemma of the paper (non-anomalous action; cited)",
    m == 1, s = <|"ok" -> True|>; order = 1; r["orbifold rests on"] = "no orbifold: gcd(24, k) = 1",
    True, s = checkCyclic[g, c["generators"]["g"], m, If[Mod[Length[bw], 3] == 0, Take[bw, Length[bw]/3], {}]];
     order = m; r["orbifold rests on"] = "GJF Thm 5.6 (cited; finite hypotheses checked here)"];
   r["symmetry checks"] = s; r["orbifold order"] = order; r["orbifold index"] = r["index"]/order;
   r["TMF minimum 24/gcd(24,k)"] = 24/m;
   r["all finite checks pass"] = TrueQ[r["length = 12k"] && r["rowspace hash = certificate"] && r["self-dual"] &&
      r["|index| = 24"] && r["index = claimed"] && s["ok"] && Abs[r["orbifold index"]] == 24/m &&
      r["orbifold index"] == c["claimedOrbifoldIndex"]];
   r];
summaryRow[r_] := {r["k"], r["id"], r["length"], r["self-dual"], r["index"], r["full-support words"],
   Lookup[r, "orbifold order", "-"], Lookup[r, "orbifold index", "-"], Lookup[r, "TMF minimum 24/gcd(24,k)", "-"],
   Style[r["all finite checks pass"], If[TrueQ[r["all finite checks pass"]], Darker[Green], Red]]};
summaryHeader = {"k", "certificate", "length", "self-dual", "Index(C)", "full-support words", "|G|", "orbifold index",
   "24/gcd(24,k)", "all checks"};

(* ::Section:: *)
(* 3. Verification of every stored code *)

(* sanity check on the ternary Golay code (k = 1): self-dual, |Index| = 24 by brute force *)
golay = Map[ToExpression, Characters /@ {"100000011111", "010000101221", "001000110122", "000100121012",
     "000010122101", "000001112210"}, {2}];
Print[{selfDualQ[golay], bruteIndex[golay]}];

results = AbsoluteTiming[verifyCode /@ codeData];
Print["total time: ", Round[First[results], 0.1], " s"];
results = Last[results];
Print[Grid[Prepend[summaryRow /@ results, summaryHeader], Frame -> All, Background -> {None, {LightGray}}]];

Print[(* full report of one certificate, e.g. the seed: *)
Dataset[First[Select[results, #["id"] == "k06_claude_canonical" &]]]];

(* ::Section:: *)
(* 4. Looking at a code and its transfer matrices *)

(* ::Text:: *)
(* showCode[k] prints the code at that k (showCode[k, 2] the second certificate, if any). showTransfer[k] computes the transfer matrices T_i, shows their sizes, whether consecutive cells are identical, and recomputes the index; for the k = 6 seed it also compares Tr(J M^L) with the values printed in the paper. The returned association holds the matrices: tm = showTransfer[6]; MatrixForm[tm["T"][[1]]]. *)

(* showCode[k] (or showCode[k, j] for the j-th certificate at that k) prints the stored code;
   showTransfer[k] computes and displays its transfer matrices. *)
codeFor[k_Integer, j_Integer: 1] := codesByK[k][[j]];
showCode[k_Integer, j_Integer: 1] := Module[{c = codeFor[k, j], g},
   g = genMatrix[c];
   Column[{Style[c["id"] <> ":  " <> c["construction"], Bold],
     Row[{"length ", Length[First[g]], ",  dimension ", Length[g], ",  band widths ", c["bandWidths"],
       ",  symmetry ", c["group"]}],
     MatrixPlot[g, ColorRules -> {0 -> White, 1 -> Black, 2 -> Red}, ImageSize -> 500, FrameTicks -> None],
     "generator rows (2 = -1):",
     Column[Style[#, FontFamily -> "Courier", 8] & /@ c["generator"]]}, Spacings -> 1]];
negationMatrix[st_] := Module[{pos = AssociationThread[st -> Range[Length[st]]]},
   Normal[SparseArray[Table[{a, pos[Mod[-st[[a]], 3]]} -> 1, {a, Length[st]}], {Length[st], Length[st]}]]];
showTransfer[k_Integer, j_Integer: 1] := Module[{c = codeFor[k, j], g, tm, ts, L},
   g = genMatrix[c]; tm = transferMatrices[g, c["bandWidths"]]; ts = tm["T"]; L = Length[ts];
   Print[Grid[Prepend[Table[{i - 1, Dimensions[ts[[i]]], Count[Flatten[ts[[i]]], x_ /; x != 0],
        If[i > 1, ts[[i]] === ts[[i - 1]], "-"]}, {i, L}],
      {"block i", "size of T_i", "nonzero entries", "T_i = T_(i-1)"}], Frame -> All]];
   Print["Index(C) = Tr(T_0 ... T_(L-1)) = ", Tr[Dot @@ ts], ";  full-support words = Tr(U_0 ... U_(L-1)) = ", Tr[Dot @@ tm["U"]]];
   If[KeyExistsQ[c, "paperTrJML"],
    Module[{jm = negationMatrix[tm["states"][[1]]], m1 = ts[[1]]},
     Print["paper's cell matrix M = T_0 with J = (u -> -u):  Tr(J M^L), L = 1..6: ",
      Table[Tr[jm . MatrixPower[m1, l]], {l, 6}], "   stored in the certificate: ", c["paperTrJML"]]]];
   tm];

Print[showCode[6]];

tm = showTransfer[6];
Print[MatrixForm[tm["T"][[1]]]];

showTransfer[21];

(* ::Section:: *)
(* 5. All k: index arithmetic *)

(* Rows of Theorem 1 without a new code: index arithmetic on the theories above (constructions cited in the paper).
   Sym^2 of a theory of index I has index (I^2 + 3 I)/2; the twisted D4 orbifold of four copies has
   (I^4 + 6 I^3 + 3 I^2 - 18 I)/8; tensor products multiply; stacking with Arf flips the sign.
   k <= 5: Duncan (k = 1) and Gaiotto-Johnson-Freyd (k = 2..5), cited. *)
sym2[i_] := (i^2 + 3 i)/2;  d4twisted[i_] := (i^4 + 6 i^3 + 3 i^2 - 18 i)/8;
(* orbifold index per k from the certificates that pass all checks (the last such certificate at each k) *)
codeT = Association[Table[r["k"] -> r["orbifold index"], {r, Select[results, TrueQ[#["all finite checks pass"]] &]}]];
t = Join[<|1 -> 24, 2 -> 12, 3 -> 8, 4 -> 6, 5 -> 24|>, codeT];
t[12] = sym2[t[6]];                   (* T' = Sym^2 T_6, needs I(T_6) = -4 *)
t[17] = t[8] t[9]; t[19] = t[16] t[3]; t[20] = t[8] t[12]; t[22] = t[16] t[6]; t[23] = t[8] t[15];
t[24] = sym2[-t[12]];                 (* T'' = Sym^2(T' (x) Arf) *)
Print["T'' = Sym^2(-Sym^2 T_6): ", t[24], ";  twisted D4 orbifold of T_6^4: ", d4twisted[t[6]]];
Do[If[! KeyExistsQ[t, k], t[k] = t[k - 24] t[24]], {k, 25, 48}];
Print[Grid[Prepend[Table[{k, 12 k, t[k], 24/GCD[24, k], Abs[t[k]] == 24/GCD[24, k],
     Which[k <= 5, "cited (Duncan, GJF)", MemberQ[Keys[codeT], k], "code above",
      MemberQ[{12, 24}, k], "symmetric square", k < 24, "tensor product", True, "T_(k-24) (x) T_24"]}, {k, 1, 48}],
   {"k", "c", "index", "24/gcd(24,k)", "minimal", "how"}], Frame -> All]];

(* ::Section:: *)
(* 6. Optional: comparison with the published certificates *)

(* ::Text:: *)
(* Needs an internet connection; nothing above depends on it. Each certificate is downloaded from the certificates folder of the published notes (https://du-pei-physics.github.io/holomorphic-svoa/certificates/) and compared with the record stored in section 1, both as a file (SHA-256 of the bytes against the file this notebook was built from) and field by field. A failed download is reported as such. It runs only when checkPublished is set to True in the cell, so evaluating the whole notebook or the script makes no network request. *)

(* Optional; needs an internet connection.  The verification above does not depend on this cell.
   Downloads every certificate from the published notes and compares it with the record stored in section 1:
   the SHA-256 of the downloaded file against that of the file this notebook was built from, and field by field
   (generator, band widths, symmetry group and generators, claimed values, rowspace hash). *)
certBase = "https://du-pei-physics.github.io/holomorphic-svoa/certificates/";
compareKeys = {"k", "generator", "bandWidths", "group", "generators", "claimedIndex", "claimedOrbifoldOrder",
   "claimedOrbifoldIndex", "sha256"};
webRecord[j_Association] := (<|"k" -> j["k"], "generator" -> j["generator"], "bandWidths" -> j["band_widths"],
     "group" -> j["symmetry"]["group"],
     "generators" -> Association[KeyValueMap[#1 -> <|"perm" -> #2["permutation"], "signs" -> #2["signs"]|> &,
        Lookup[j["symmetry"], "generators", <||>]]],
     "claimedIndex" -> j["claimed_code_index"], "claimedOrbifoldOrder" -> j["claimed_orbifold_order"],
     "claimedOrbifoldIndex" -> j["claimed_orbifold_index"], "sha256" -> j["rowspace_sha256"]|> /. Null -> Missing[]);
webCheck[c_Association] := Module[{resp, bytes, j},
   resp = Quiet[Check[URLRead[certBase <> c["id"] <> ".json"], $Failed]];
   If[Head[resp] =!= HTTPResponse, Return[{c["id"], "download failed", "-"}]];
   If[resp["StatusCode"] =!= 200,
    Return[{c["id"], "download failed (HTTP " <> ToString[resp["StatusCode"]] <> ")", "-"}]];
   bytes = resp["BodyByteArray"];
   j = Quiet[Check[ImportByteArray[bytes, "RawJSON"], $Failed]];
   If[! AssociationQ[j], Return[{c["id"], Hash[bytes, "SHA256", "HexString"] === c["fileSHA256"], "not JSON"}]];
   {c["id"], Hash[bytes, "SHA256", "HexString"] === c["fileSHA256"],
    KeyTake[webRecord[j], compareKeys] === KeyTake[c, compareKeys]}];
checkPublished = False;
Print[(* change to True and evaluate this cell to run the comparison *)
If[TrueQ[checkPublished],
 web = webCheck /@ codeData;
 Print["published certificates identical to the stored records: ",
  Count[web, {_, True, True}], " of ", Length[web], " (file and content)"];
 Grid[Prepend[web, {"certificate", "file identical", "content identical"}], Frame -> All],
 "comparison not run (set checkPublished = True in this cell)"]];
